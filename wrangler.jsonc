{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Hourly; the code decides by New York time (each alert's frequency, reminders at 7am), so DST needs no second schedule.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Set these after creating the Access application (Zero Trust → Access → Applications).
    "TEAM_DOMAIN": "",
    "POLICY_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "golf",
      // Replace with the id printed by `pnpm wrangler d1 create golf` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
